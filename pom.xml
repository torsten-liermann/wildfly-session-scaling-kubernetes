<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.torsten-liermann</groupId>
  <artifactId>wildfly-jsf-jpa-kubernetes</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>WildFly session scaling on Kubernetes</name>
  <description>A clustered Jakarta EE web application with server-side session state that scales horizontally on Kubernetes.</description>

  <modules>
    <module>app</module>
    <module>image</module>
  </modules>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>

    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-11-10T00:00:00Z</project.build.outputTimestamp>

    <!-- Application -->
    <version.jakartaee>10.0.0</version.jakartaee>
    <version.primefaces>16.0.2</version.primefaces>

    <!-- Server and image -->
    <version.wildfly>42.0.0.Final</version.wildfly>
    <version.wildfly.datasources>11.5.0.Final</version.wildfly.datasources>
    <runtime.image>eclipse-temurin:21.0.13_9-jre-noble@sha256:0eda5830ed7b669abc246a8dc520ea8a23cab06f9a8d4b6964109e2f2394e46f</runtime.image>
    <image.name>wildfly-session-scaling:${revision}</image.name>

    <!-- Plugins -->
    <version.plugin.antrun>3.2.0</version.plugin.antrun>
    <version.plugin.assembly>3.8.0</version.plugin.assembly>
    <version.plugin.clean>3.5.0</version.plugin.clean>
    <version.plugin.deploy>3.2.0</version.plugin.deploy>
    <version.plugin.compiler>3.16.0</version.plugin.compiler>
    <version.plugin.dependency>3.11.0</version.plugin.dependency>
    <version.plugin.enforcer>3.7.0</version.plugin.enforcer>
    <version.plugin.flatten>1.9.0</version.plugin.flatten>
    <version.plugin.install>3.2.0</version.plugin.install>
    <version.plugin.jar>3.5.1</version.plugin.jar>
    <version.plugin.jib>3.5.2</version.plugin.jib>
    <version.plugin.resources>3.5.0</version.plugin.resources>
    <version.plugin.site>3.22.0</version.plugin.site>
    <version.plugin.surefire>3.6.1</version.plugin.surefire>
    <version.plugin.war>3.5.1</version.plugin.war>
    <version.plugin.wildfly>6.2.0.Final</version.plugin.wildfly>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.wildfly.bom</groupId>
        <artifactId>wildfly-ee</artifactId>
        <version>${version.wildfly}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>${version.plugin.antrun}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${version.plugin.assembly}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${version.plugin.clean}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${version.plugin.compiler}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${version.plugin.deploy}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${version.plugin.dependency}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${version.plugin.install}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${version.plugin.jar}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${version.plugin.resources}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${version.plugin.site}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${version.plugin.surefire}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>${version.plugin.war}</version>
        </plugin>
        <plugin>
          <groupId>org.wildfly.plugins</groupId>
          <artifactId>wildfly-maven-plugin</artifactId>
          <version>${version.plugin.wildfly}</version>
        </plugin>
        <plugin>
          <groupId>com.google.cloud.tools</groupId>
          <artifactId>jib-maven-plugin</artifactId>
          <version>${version.plugin.jib}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${version.plugin.enforcer}</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requirePluginVersions/>
                <requireReleaseDeps>
                  <onlyWhenRelease>false</onlyWhenRelease>
                  <excludes>
                    <exclude>${project.groupId}:*</exclude>
                  </excludes>
                </requireReleaseDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Resolves ${revision} in installed POMs (CI-friendly versions) -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${version.plugin.flatten}</version>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
